<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Activate your plan | ReviewReply</title>
  <meta name="description" content="Activate a ReviewReply paid plan with the license key from your Gumroad receipt.">
  <meta name="robots" content="noindex">
  <link rel="canonical" href="https://www.reviewreply.store/pro">
<%- include("partials/assets") %>
  <style>
    .act{max-width:560px;margin:0 auto;padding:56px 20px 72px}
    .act h1{font-size:clamp(30px,5vw,42px);line-height:1.08;margin-bottom:12px}
    .act p{color:var(--ink-2)}
    .act form{margin-top:22px;background:var(--card);border:1px solid var(--ink);border-radius:18px;padding:22px;box-shadow:8px 8px 0 var(--green)}
    .act label{display:block;font-size:13px;font-weight:600;color:var(--ink-2);margin-bottom:6px}
    .act input{width:100%;font:inherit;font-size:15px;color:var(--ink);background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:11px 12px}
    .act input:focus{outline:none;border-color:var(--green);box-shadow:0 0 0 3px var(--green-soft)}
    .act .btn{width:100%;height:50px;margin-top:14px;font-size:16px}
    .act .err{margin-top:16px;border:1px solid #efd9a8;background:#fdf6e6;border-radius:12px;padding:12px 14px}
    .act .ok{margin-top:16px;border:1px solid var(--line);background:var(--green-soft);border-radius:12px;padding:12px 14px}
    .act small{display:block;margin-top:14px;color:var(--muted);font-size:13px}
  </style>
</head>
<body>
<%- include("partials/nav") %>
<main class="act">
  <h1>Activate your plan</h1>
  <p>Paste the license key from your Gumroad receipt email. It lifts the 300-character limit on reviews in this browser.</p>
  <% if (active) { %><div class="ok">A paid plan is already active in this browser. <a href="/#tool">Write a reply</a></div><% } %>
  <% if (error) { %><div class="err" role="alert"><%= error %></div><% } %>
  <form method="POST" action="/pro">
    <label for="license_key">License key</label>
    <input id="license_key" name="license_key" required autocomplete="off" spellcheck="false" placeholder="XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX">
    <button type="submit" class="btn">Activate</button>
  </form>
  <small>No plan yet? <a href="/#pricing">See plans</a>. Can't find the key? Search your inbox for the Gumroad receipt, or reply to it and ask.</small>
</main>
<%- include("partials/footer") %>
</body>
</html>
